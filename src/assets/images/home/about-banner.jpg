.landing-about{

  position:relative;

  padding:80px 40px;

  overflow:hidden;

  background:
    linear-gradient(
      rgba(15,23,42,.78),
      rgba(15,23,42,.78)
    ),
    url("/images/about-banner.jpg");

  background-size:cover;

  background-position:center;

  background-repeat:no-repeat;

}
.about-header h2{

  font-size:42px;

  font-weight:800;

  color:#ffffff;

}



.about-header p{

  max-width:700px;

  margin:14px auto 0;

  color:#e2e8f0;

  font-size:17px;

  line-height:1.7;

}

.about-card{

  background:rgba(255,255,255,.96);

  backdrop-filter:blur(10px);

  padding:28px;

  min-height:300px;

  border-radius:22px;

  border:1px solid rgba(255,255,255,.25);

  border-top:5px solid #22c55e;

  box-shadow:0 15px 35px rgba(0,0,0,.15);

  transition:.35s ease;

}